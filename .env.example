# Final canonical URL, including protocol. Set this to the Vercel deployment/domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional comma-separated additional first-party origins (for preview deployments).
ALLOWED_ORIGINS=

# Configure a verified sender domain in Resend, then set these server-only values.
# Without them the form reports honestly that it has not sent the request.
RESEND_API_KEY=
RESERVATION_FROM_EMAIL=
RESERVATION_TO_EMAIL=

# Enable Places API (New) in Google Cloud; restrict the key to that API.
# Confirm the candidate place ID matches the restaurant before enabling.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJI-vDF-qJJRMRObrY4JlPg_E

# Reserved for a later approved TheFork B2B integration. Adapter is not enabled.
THEFORK_CLIENT_ID=
THEFORK_CLIENT_SECRET=
THEFORK_RESTAURANT_UUID=
